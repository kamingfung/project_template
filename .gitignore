##########################
# KEDRO PROJECT

# Ignore potentially sensitive credentials files
conf/**/*credentials*
**/credentials.yml

# Ignore data and notebooks by default, keeping folder structure and sample raw inputs
data/**
notebooks/**
experiments/**
!data/**/
!data/01_raw/*.csv
!notebooks/explore_fleet.py
!.gitkeep

# Ignore kedro-viz metadata
.viz/

# Ignore file-based logs and profiling outputs
*.log
*.log.*
profiling/*
!profiling/.gitkeep

##########################
# MLFLOW

mlruns/
mlartifacts/
mlflow.db
mlflow.db-*

##########################
# PYTHON & TOOLING

__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.envrc
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
.python-version

# Testing, coverage, and linters
htmlcov/
.tox/
.coverage
.coverage.*
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Jupyter Notebook
.ipynb_checkpoints/
.ipython/profile_default/history.sqlite
.ipython/profile_default/startup/README

# Sphinx documentation
docs/_build/

